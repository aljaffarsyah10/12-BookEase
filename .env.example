# ==========================================
# BookEase Production Environment Variables
# ==========================================

# 1. Database Connection (Pooled connection for serverless runtime - port 6543 on Supabase / Neon pgbouncer)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct Database Connection (Unpooled direct connection for migrations - port 5432 on Supabase)
DIRECT_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"

# 2. Authentication & Session Security (Min 32 random characters - generate with: openssl rand -base64 32)
# Supported keys: AUTH_SECRET or SESSION_SECRET
AUTH_SECRET="your-super-secret-auth-key-at-least-32-chars-long"
SESSION_SECRET="your-super-secret-auth-key-at-least-32-chars-long"

# 3. Customer Cancellation HMAC Token Secret (Min 32 random characters)
# Supported keys: CANCELLATION_TOKEN_SECRET or CANCELLATION_SECRET
CANCELLATION_TOKEN_SECRET="your-super-secret-cancellation-hmac-key-32-chars"
CANCELLATION_SECRET="your-super-secret-cancellation-hmac-key-32-chars"

# 4. Public Application Canonical URL (without trailing slash)
NEXT_PUBLIC_APP_URL="https://bookease.id"

# 5. Resend Transactional Email API Key
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"

# Sender Email Address (Domain must be verified in Resend dashboard)
RESEND_FROM_EMAIL="BookEase <notifications@bookease.id>"
EMAIL_FROM="BookEase <noreply@bookease.id>"
