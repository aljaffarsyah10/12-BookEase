datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business     Business?

  @@map("users")
}

model Business {
  id                String          @id @default(cuid())
  ownerId           String          @unique
  name              String
  slug              String          @unique
  category          String          @default("General")
  description       String?
  address           String?
  phone             String?
  logoUrl           String?
  timezone          String          @default("Asia/Jakarta")
  bufferTimeMinutes Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  owner             User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  services          Service[]
  staff             Staff[]
  operatingHours    OperatingHour[]
  bookings          Booking[]

  @@map("businesses")
}

model Service {
  id              String         @id @default(cuid())
  businessId      String
  name            String
  description     String?
  price           Int            // Dalam Rupiah bulat
  durationMinutes Int            // Durasi dalam menit (> 0)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffServices   StaffService[]
  bookings        Booking[]

  @@index([businessId, isActive])
  @@map("services")
}

model Staff {
  id            String         @id @default(cuid())
  businessId    String
  name          String
  roleOrTitle   String?
  bio           String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffServices StaffService[]
  bookings      Booking[]

  @@index([businessId, isActive])
  @@map("staff")
}

model StaffService {
  staffId    String
  serviceId  String
  assignedAt DateTime @default(now())

  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([serviceId])
  @@map("staff_services")
}

model OperatingHour {
  id         String   @id @default(cuid())
  businessId String
  dayOfWeek  Int      // 0 = Minggu, 1 = Senin, ..., 6 = Sabtu
  openTime   String   // "HH:mm"
  closeTime  String   // "HH:mm"
  isClosed   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@map("operating_hours")
}

model Booking {
  id                      String        @id @default(cuid())
  reference               String        @unique // e.g. "BK-20261106-9X4K2P"
  businessId              String
  serviceId               String
  staffId                 String
  customerName            String
  customerEmail           String
  customerPhone           String
  customerNotes           String?
  serviceNameSnapshot     String
  servicePriceSnapshot    Int
  durationMinutesSnapshot Int
  bufferMinutesSnapshot   Int           @default(0)
  startAt                 DateTime      // Disimpan dalam UTC
  endAt                   DateTime      // Disimpan dalam UTC
  occupiedEndAt           DateTime      // Disimpan dalam UTC (endAt + buffer)
  status                  BookingStatus @default(PENDING)
  cancelledAt             DateTime?
  cancelReason            String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  business                Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service                 Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff                   Staff         @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([businessId, startAt])
  @@index([businessId, status])
  @@index([staffId, startAt, occupiedEndAt])
  @@map("bookings")
}
